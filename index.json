{
  "indexVersion": 1,
  "name": "xiaoqi NewAPI Task Plugins",
  "plugins": [
    {
      "key": "aicost",
      "name": "aicost API",
      "icon": "text:aicost",
      "description": {
        "en": "aicost.me relay: Seedance / MiniMax H3 video and GPT-Image / Gemini image, per-call models only.",
        "zh": "aicost.me 中转:Seedance / MiniMax H3 视频与 GPT-Image / Gemini 图片,仅按次计费模型。"
      },
      "models": [
        "gpt-image-2",
        "gpt-image-2.5-flare",
        "gpt-image-2.5-sunburst",
        "gemini-3-pro-image-preview",
        "gemini-3.1-flash-image-preview",
        "seedance2.0-900-3",
        "seedance2.5-vid",
        "seedance2.0-480p",
        "seedance2.0-720p",
        "seedance2.5-900"
      ],
      "latest": "1.0.5",
      "versions": [
        {
          "version": "1.0.5",
          "path": "plugins/tasks/aicost/1.0.5/plugin.js",
          "sha256": "397d0c80086f54913e7fe01e90f1f5fe76ad36b482ad3159a6fbba4d611b7d30",
          "minApiVersion": 1,
          "kind": "task",
          "allowedHosts": [
            "www.aicost.me",
            "aicost.me"
          ],
          "baseUrl": "https://www.aicost.me"
        }
      ],
      "routes": [
        {
          "method": "POST",
          "path": "/aicost/v1/images/generations",
          "type": "submit",
          "action": "image",
          "decode": "decodeImageSubmit",
          "render": "imageResult",
          "models": [
            "gpt-image-2",
            "gpt-image-2.5-flare",
            "gpt-image-2.5-sunburst",
            "gemini-3-pro-image-preview",
            "gemini-3.1-flash-image-preview"
          ]
        },
        {
          "method": "POST",
          "path": "/aicost/v1/images/edits",
          "type": "submit",
          "action": "image",
          "decode": "decodeImageEditSubmit",
          "render": "imageResult",
          "models": [
            "gpt-image-2",
            "gpt-image-2.5-flare",
            "gpt-image-2.5-sunburst",
            "gemini-3-pro-image-preview",
            "gemini-3.1-flash-image-preview"
          ]
        },
        {
          "method": "POST",
          "path": "/aicost/v1/gemini-images",
          "type": "submit",
          "action": "image",
          "decode": "decodeGeminiImageSubmit",
          "render": "imageResult",
          "models": [
            "gemini-3-pro-image-preview",
            "gemini-3.1-flash-image-preview"
          ]
        },
        {
          "method": "GET",
          "path": "/aicost/v1/images/tasks/:task_id",
          "type": "query",
          "render": "imageTaskStatus"
        }
      ],
      "protocols": [
        {
          "name": "openai_video",
          "models": [
            "seedance2.0-900-3",
            "seedance2.5-vid",
            "seedance2.0-480p",
            "seedance2.0-720p",
            "seedance2.5-900"
          ]
        }
      ]
    },
